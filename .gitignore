# Generated data. Reproducible from scripts/generate_dataset.py with the
# per-env seeds, and far too large for git (300 shards x 55 MB).
data/
data1/
*.npz

# Training outputs.
checkpoints/
*.pt
*.pth
wandb/
logs/
*.log

# LaTeX build artifacts. The .out here is hyperref's bookmark file; the
# experiment tables in results/ share the extension and are tracked, which is
# why these are scoped to paper/ rather than matched globally.
paper/*.aux
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# Python bytecode and caches.
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtualenvs: absolute paths and host-specific compiled extensions.
.venv/
venv/

# Figures regenerated by scripts/make_demo_figures.py and demo.py.
*.png

# Local-only: superseded drafts and stray generated files, kept out of the
# public tree. Nothing here is needed to reproduce anything.
_archive/
